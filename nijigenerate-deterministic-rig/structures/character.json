  "shared_surface_policy": {
    "canonical_owners": [
      "head",
      "torso",
      "left_screen_arm",
      "right_screen_arm",
      "left_screen_leg",
      "right_screen_leg"
    ],
    "body_cloth": "身体基礎体積と局所的な胸面はtorsoで一度だけ評価。密着衣装は共有面の登録と離隔を持ち、同じ体積を衣装側へ再加算しない。",
    "inheritance": "描画hierarchyが深度継承の証明ではない。compilerは実評価した親寄与を引いてresidualまたは独立surfaceのいずれか一つを採用。",
    "host_offset": "surface_layerのhost_depthは共有宿主から同一material coordinates・単位へsampleして渡す。host未確定で0面を仮定しない。",
    "shadow": "shadow/decalは原則host共有面とoffset=0。暗いtextureをdepthとして扱わない。",
    "carrier_conflict": "一つのGridの同じ位置へ異なる独立surfaceが必要なら複数carrier計画へ分ける。平均値に潰さない。"
  },
