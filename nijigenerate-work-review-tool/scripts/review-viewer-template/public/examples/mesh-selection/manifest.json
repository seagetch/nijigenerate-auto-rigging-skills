{
  "schema": "review-viewer-manifest-v1",
  "mode": "mesh-selection",
  "model": {
    "id": "mesh-selection-example",
    "name": "Direct Face and Body Residual Review Example",
    "createdAt": "2026-05-04"
  },
  "review": {
    "schema": "mesh-selection-review-v1",
    "mode": "mesh-selection",
    "resultsDir": "reviews",
    "latestReview": "reviews/latest-review.json"
  },
  "assets": {
    "original": "images/original.svg"
  },
  "targets": [
    {
      "key": "faceLayers",
      "label": "Yaw +1 Face Direct Residual",
