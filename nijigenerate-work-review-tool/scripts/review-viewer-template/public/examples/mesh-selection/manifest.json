      "deformations": "deformations/initial.json#/targets/faceLayers",
      "color": "#d4e157"
    },
    {
      "key": "bodyLayers",
      "label": "Yaw +1 Body Direct Residual",
      "image": "images/overlay.svg",
      "meshes": "meshes/layers.json#/targets/bodyLayers",
      "deformations": "deformations/initial.json#/targets/bodyLayers",
      "color": "#54d5ff"
    }
  ],
  "initialTags": "tags/initial-tags.json",
  "notes": {
    "rule": "Direct residual edits are reviewed before application and again after application.",
    "projection": {
      "baseRig": "Use the accepted yaw/pitch projection first; keep these arrows as local residual cleanup only.",
